[Unit]
Description=Homelab Log Auditor (Mini-SIEM & Active IPS)
After=network-online.target nftables.service
Wants=network-online.target

[Service]
Type=simple
WorkingDirectory=/opt/homelab-log-auditor
StateDirectory=homelab-auditor
ExecStart=/usr/bin/python3 /opt/homelab-log-auditor/auditor.py --config /etc/homelab-auditor/config.json --db /var/lib/homelab-auditor/auditor_state.db --enforce --web
ExecReload=/bin/kill -HUP $MAINPID
Restart=on-failure
RestartSec=5s

# Hardening systemd & Princípio do Menor Privilégio
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
ReadWritePaths=/var/lib/homelab-auditor
AmbientCapabilities=CAP_NET_ADMIN
CapabilityBoundingSet=CAP_NET_ADMIN

[Install]
WantedBy=multi-user.target
