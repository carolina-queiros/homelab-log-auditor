[Unit]
Description=Homelab Log Auditor (Mini-SIEM & Active IPS)
After=network-online.target nftables.service
Wants=network-online.target

[Service]
Type=simple
WorkingDirectory=/opt/homelab-log-auditor
ExecStart=/usr/bin/python3 /opt/homelab-log-auditor/auditor.py --config /etc/homelab-auditor/config.json --enforce --web
ExecReload=/bin/kill -HUP $MAINPID
Restart=on-failure
RestartSec=5s

# Hardening systemd
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes

[Install]
WantedBy=multi-user.target
